{
  "name": "perplexity-desktop-broker",
  "version": "0.1.0",
  "private": true,
  "description": "Local desktop broker for Perplexity web UI via Playwright",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "dev:broker": "pnpm --filter @pdb/broker dev",
    "dev:mcp": "pnpm --filter @pdb/mcp-server dev",
    "doctor": "pnpm --filter @pdb/doctor start",
    "test": "vitest run",
    "test:smoke": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:live": "vitest run --config vitest.integration.config.ts",
    "lint": "eslint .",
    "test:e2e": "node scripts/e2e-thread-status.mjs",
    "test:e2e:long": "SKIP_SMOKE=1 node scripts/e2e-thread-status.mjs",
    "test:e2e:smoke": "ONLY_SMOKE=1 node scripts/e2e-thread-status.mjs",
    "smoke:worker": "pnpm --filter @pdb/playwright-worker smoke",
    "camoufox:fetch": "pnpm --filter @pdb/playwright-worker exec camoufox-js fetch",
    "launchd:install": "bash scripts/install-launch-agent.sh",
    "launchd:uninstall": "bash scripts/uninstall-launch-agent.sh",
    "typecheck": "pnpm -r run typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.15.29",
    "eslint": "^10.4.0",
    "globals": "^17.6.0",
    "tsx": "^4.19.4",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.60.0",
    "vite": "8.2.1",
    "vitest": "4.1.7"
  },
  "packageManager": "pnpm@10.11.0",
  "pnpm": {
    "overrides": {
      "hono": "4.13.3",
      "@hono/node-server": "1.19.17",
      "fast-uri": "3.1.5",
      "ip-address": "10.5.0",
      "find-my-way": "9.8.0",
      "adm-zip": "0.6.0",
      "ua-parser-js": "2.0.10",
      "body-parser": "2.3.0",
      "postcss": "8.5.26",
      "vite": "8.2.1",
      "brace-expansion": "5.0.9",
      "esbuild": "0.28.2"
    }
  }
}
